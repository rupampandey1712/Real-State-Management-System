# =============================================================================
# EstateAI — local configuration for docker compose (all services read this file).
# Copy to .env. Values below are the well-known, public LOCAL EMULATOR credentials —
# they are not secrets. Real Azure credentials live in Key Vault, never in this file.
#
# Per-service database URLs are NOT set here: each service defaults to its own database
# (database-per-service). Override DATABASE_URL only in that service's environment.
# =============================================================================

# --- Core ---------------------------------------------------------------------
APP_ENV=local                      # local | staging | prod  (local enables dev seed users, dev OTP hint, /docs)
LOG_LEVEL=INFO

# --- Auth (ADR-0009) ---------------------------------------------------------------
JWT_ISSUER=estateai-identity
JWT_AUDIENCE=estateai
ACCESS_TOKEN_TTL_S=900             # 15 min; refresh tokens rotate (ADR-0015)
REFRESH_TOKEN_TTL_S=2592000        # 30 days
SIGNING_KEY_ROTATION_DAYS=30       # RS256 keys; JWKS at identity /.well-known/jwks.json

# --- Azure Service Bus emulator (ADR-0011) --------------------------------------------
SERVICEBUS_CONNECTION=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
MSSQL_SA_PASSWORD=Estate_Local_Dev_Passw0rd!

# --- Azure Storage (Azurite) ---------------------------------------------------------------
STORAGE_CONNECTION=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
MEDIA_CONTAINER=listing-media

# --- Azure Cosmos DB emulator (ADR-0012) ------------------------------------------------------
COSMOS_ENDPOINT=http://cosmos:8081/
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE=estateai

# --- Redis / email ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@estateai.local
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI: Google Gemini (ADR-0013) — server-side only, used only by the ai service ------------
AI_FAKE=true                       # true = offline FakeLLMClient; set false + GEMINI_API_KEY for real Gemini
GEMINI_API_KEY=                    # from Google AI Studio (aistudio.google.com/apikey); in Azure: Key Vault secret
AI_MODEL_SEARCH=gemini-3.1-flash-lite
AI_MODEL_DESCRIBE=gemini-3.8-flash
AI_MODEL_QA=gemini-3.8-flash
AI_MODEL_JUDGE=gemini-3.1-pro-preview
AI_TIMEOUT_SEARCH_S=1.5
AI_TIMEOUT_DESCRIBE_S=30
AI_TIMEOUT_QA_S=30
AI_MAX_RETRIES=2
AI_PROMPT_VERSION_NL_SEARCH=1      # rollback = change the number, restart ai service
AI_PROMPT_VERSION_DESCRIBE=1
AI_PROMPT_VERSION_QA=1
AI_LOG_RETENTION_DAYS=30

# --- Embeddings (ADR-0003) ---------------------------------------------------------------------
EMBEDDING_PROVIDER=fake            # fake (offline hashing) | gemini (uses GEMINI_API_KEY)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768                  # read by ai AND search; changing it needs a fresh vector index (T2.10)

# --- Search ranking (docs/design.md §4.3) --------------------------------------------------------
RANK_W_SEMANTIC=0.55
RANK_W_FILTER=0.30
RANK_W_FRESHNESS=0.15
NL_PARSE_TIMEOUT_S=2.0
NL_SEARCH_CACHE_TTL_S=86400

# --- Q&A retrieval (docs/design.md §4.5) ----------------------------------------------------------
QA_TOP_K_CHUNKS=6
QA_MIN_SIMILARITY=0.3
QA_MAX_HISTORY_TURNS=6

# --- Resilience for service-to-service HTTP (ADR-0016) -------------------------------------------
HTTP_TIMEOUT_S=5
HTTP_RETRIES=2
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_S=30
# Gateway rate limits live in services/gateway/src/Gateway/appsettings.json (RateLimits:*);
# override in compose with e.g. RateLimits__NlSearch__PermitLimit=60

# --- Feature flags ----------------------------------------------------------------------------------
FEATURE_NL_SEARCH=true
FEATURE_AI_DESCRIBE=true
FEATURE_LISTING_QA=true
